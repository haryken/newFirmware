# EMO-Bridge default sdkconfig. Targets a WROVER-class ESP32 (4MB+ flash, PSRAM),
# which matches the original EMO board (PSRAM is referenced in the stock firmware).

CONFIG_IDF_TARGET="esp32"

# --- Flash / partitions ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- PSRAM: used as the audio backlog buffer for lossless retransmit ---
CONFIG_ESP32_SPIRAM_SUPPORT=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

# --- CPU / FreeRTOS ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# --- Main task stack (web + TLS need headroom) ---
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- HTTP server: allow enough handlers/headers for the UI + MCP ---
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=1024
CONFIG_HTTPD_WS_SUPPORT=y

# --- TLS: mbedTLS with SNI + dynamic buffers to fit Anthropic's cert chain ---
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# --- SPIFFS (motion files): path names up to 63 chars ---
CONFIG_SPIFFS_OBJ_NAME_LEN=64

# --- Logging ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- IRAM: keep iram0 under the ESP32 limit (SNTP + Daily schedule needs headroom) ---
# CONFIG_RMT_ENCODER_FUNC_IN_IRAM is not set
# CONFIG_RMT_TX_ISR_HANDLER_IN_IRAM is not set
# CONFIG_RMT_RX_ISR_HANDLER_IN_IRAM is not set
# CONFIG_MCPWM_ISR_HANDLER_IN_IRAM is not set
# CONFIG_ESP_PHY_IRAM_OPT is not set
# CONFIG_SPIRAM_CACHE_LIBJMP_IN_IRAM is not set
# CONFIG_SPIRAM_CACHE_LIBNUMPARSER_IN_IRAM is not set
# CONFIG_SPIRAM_CACHE_LIBIO_IN_IRAM is not set

# --- EMO-Bridge defaults that newer builds expect ---
CONFIG_EMO_MOTION_SPEED_PCT=100
# Stock gait = MCPWM always driven at boot (FUN_40262f7c). Keep PWM on so desk
# twitch tests are visible; set IDLE_MS>0 later to save current if needed.
CONFIG_EMO_SERVO_HOLD_AT_BOOT=y
CONFIG_EMO_SERVO_IDLE_MS=0
